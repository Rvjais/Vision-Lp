# This folder deploys to /landing-page/landing-page/ on the live server
# (repo root itself is uploaded as /landing-page/). Forward everything here
# to the canonical slug: /landing-page/eye-treatment-in-delhi/
<IfModule mod_rewrite.c>
  RewriteEngine On

  # /landing-page/landing-page/ (this dir) -> canonical slug (keeps query string, e.g. UTMs)
  RewriteRule ^$ /landing-page/eye-treatment-in-delhi/ [R=301,L,QSA]

  # /landing-page/landing-page/eye-treatment-in-delhi or eye-tratment-in-delhi -> canonical slug
  RewriteRule ^eye-tratment-in-delhi/?$ /landing-page/eye-treatment-in-delhi/ [R=301,L,QSA]
  RewriteRule ^eye-treatment-in-delhi/?$ /landing-page/eye-treatment-in-delhi/ [R=301,L,QSA]
</IfModule>
